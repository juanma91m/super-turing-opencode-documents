}

gateway -> services.payment: REST
gateway -> services.account: REST
gateway -> services.notification: REST
services.payment -> platform.postgres
services.account -> platform.redis
services.payment -> platform.kafka: eventos
services.notification -> platform.kafka: consume
services.notification -> platform.observability

