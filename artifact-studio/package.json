{
  "name": "@super-turing/artifact-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "artifact": "dist/src/cli/index.js"
  },
  "scripts": {
    "artifact": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration.test.ts",
    "golden": "tsx src/cli/index.ts generate examples/executive-status/spec.json --format all --output artifacts/output --name executive-status",
    "golden:qa": "tsx src/cli/index.ts preview artifacts/output/executive-status.pdf && tsx src/cli/index.ts preview artifacts/output/executive-status.pptx && tsx src/cli/index.ts preview artifacts/output/executive-status.docx"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "docx": "^9.7.1",
    "docxtemplater": "^3.69.3",
    "lucide-static": "^1.34.0",
    "pizzip": "^3.2.0",
    "pptxgenjs": "^4.0.1",
    "sharp": "^0.35.4",
    "vega": "^6.4.0",
    "vega-lite": "^6.4.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/vega": "^3.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
