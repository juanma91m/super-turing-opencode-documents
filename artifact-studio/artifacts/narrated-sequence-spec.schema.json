{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "default": "1.0",
      "type": "string",
      "const": "1.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string"
    },
    "participants": {
      "minItems": 2,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "subtitle": {
            "type": "string"
          },
          "group": {
            "type": "string"
          },
          "kind": {
            "default": "service",
            "type": "string",
            "enum": [
              "actor",
              "service",
              "database"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "steps": {
      "minItems": 1,
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "to": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "kind": {
            "default": "message",
            "type": "string",
            "enum": [
              "navigation",
              "message",
              "internal",
              "persistence"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "existing",
              "new",
              "configuration"
            ]
          },
          "statusLabel": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "from",
          "to",
          "kind",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "notes": {
      "default": [],
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "version",
    "title",
    "participants",
    "steps",
    "notes"
  ],
  "additionalProperties": false
}
