            "chart": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "bar",
                    "line",
                    "area",
                    "scatter",
                    "stackedBar",
                    "pie",
                    "doughnut",
                    "combo"
