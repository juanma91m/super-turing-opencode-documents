{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "default": "1.0",
      "type": "string",
      "const": "1.0"
    },
    "meta": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "organization": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "sampleData": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "title",
        "sampleData"
      ],
      "additionalProperties": false
    },
    "theme": {
      "default": "executive-light",
      "type": "string",
      "enum": [
        "executive-light",
        "executive-dark",
        "technical-light"
      ]
    },
    "brand": {
      "type": "object",
      "properties": {
        "primaryColor": { "type": "string", "pattern": "^[0-9A-Fa-f]{6}$" },
        "textColor": { "type": "string", "pattern": "^[0-9A-Fa-f]{6}$" },
        "mutedColor": { "type": "string", "pattern": "^[0-9A-Fa-f]{6}$" },
        "softColor": { "type": "string", "pattern": "^[0-9A-Fa-f]{6}$" },
        "borderColor": { "type": "string", "pattern": "^[0-9A-Fa-f]{6}$" },
        "logoAssetId": { "type": "string" }
      },
      "required": [
        "primaryColor",
        "textColor",
        "mutedColor",
        "softColor",
        "borderColor"
      ],
      "additionalProperties": false
    },
    "documentMode": {
      "default": "report",
      "type": "string",
      "enum": [
        "report",
        "form"
      ]
    },
    "sections": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "subtitle": {
            "type": "string"
          },
          "blocks": {
            "default": [],
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "layoutHint": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "blocks"
        ],
        "additionalProperties": false
      }
    },
    "sources": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "publisher": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "accessedAt": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "sample": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "title",
          "sample"
        ],
        "additionalProperties": false
      }
    },
    "assets": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "alt": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "author": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "path",
          "alt"
        ],
        "additionalProperties": false
      }
    }
