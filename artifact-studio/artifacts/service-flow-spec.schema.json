{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "default": "1.0",
      "type": "string",
      "const": "1.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string"
    },
    "connectors": {
      "default": true,
      "type": "boolean"
    },
    "lanes": {
      "minItems": 2,
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "components": {
            "default": [],
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "title",
          "components"
        ],
        "additionalProperties": false
      }
    },
    "steps": {
      "minItems": 1,
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "lane": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "actor": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "lane",
          "text"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "title",
    "connectors",
    "lanes",
    "steps"
  ],
  "additionalProperties": false
}
